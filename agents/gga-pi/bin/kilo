#!/usr/bin/env bash
# GGA has no Pi provider (v2.10.1 and upstream). GGA's `kilo` provider runs
#   kilo run --auto [--model <m>]   (review prompt on stdin, answer on stdout)
# so this shim stands in for that binary and answers through `pi --print`, which
# reuses the CLIProxyAPI gateway. CLIProxyAPI review failures automatically try
# the configured gateway-only fallback models in priority order.
set -euo pipefail

model=""
while [ $# -gt 0 ]; do
  case $1 in
    run | --auto) ;;
    --model) shift; model=${1:-} ;;
    *) printf 'gga-pi: unsupported argument: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$model" ] || { printf 'gga-pi: set PROVIDER="kilo:<pi-model-or-alias>[:effort]" in .gga\n' >&2; exit 2; }
command -v pi >/dev/null 2>&1 || { printf 'gga-pi: pi is not on PATH\n' >&2; exit 127; }

agent_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
role_settings="$agent_dir/pi-ext-roles/settings.json"
resolve_model() {
  local ref=$1
  jq -er --arg ref "$ref" '
    .modelAliases as $aliases |
    def splitref:
      if test(":.*$") then [sub(":.*$"; ""), match(":([^:]+)$").captures[0].string]
      else [., null] end;
    def resolve($value; $effort; $depth):
      if $depth > 10 then error("model alias chain exceeds 10 steps") else
        ($value | splitref) as $parts |
        ($effort // $parts[1]) as $resolved_effort |
        if $aliases[$parts[0]] then resolve($aliases[$parts[0]]; $resolved_effort; $depth + 1)
        elif ($parts[0] | contains("/")) then
          {model: $parts[0], effort: $resolved_effort}
        else error("unresolved model alias or effort") end
      end;
    resolve($ref; null; 0) | .model + (if .effort == null then "" else ":" + .effort end)
  ' "$role_settings"
}

if [[ -f "$role_settings" ]]; then
  resolved_model=$(resolve_model "$model") || {
    printf 'gga-pi: cannot resolve model or alias %s from %s\n' "$model" "$role_settings" >&2
    exit 2
  }
elif [[ $model == */* ]]; then
  resolved_model=$model
else
  printf 'gga-pi: model alias %s requires Pi Ext Roles settings at %s\n' "$model" "$role_settings" >&2
  exit 2
fi
models=("$resolved_model")
if [[ $resolved_model == cliproxyapi/* ]]; then
  effort="high"
  if [[ $resolved_model == *:* ]]; then
    effort=${resolved_model##*:}
  fi
  primary_id=${resolved_model%:*}
  matrix="$agent_dir/ha.json"
  [[ -f "$matrix" ]] || matrix="$agent_dir/ha-failover.example.json"
  if [[ -f "$matrix" ]]; then
    while IFS= read -r fallback_id; do
      [[ -n "$fallback_id" && "$fallback_id" != "$primary_id" ]] || continue
      if [[ "$fallback_id" == *:* ]]; then
        models+=("$fallback_id")
      else
        models+=("$fallback_id:$effort")
      fi
    done < <(jq -er --arg group reviewer '.groups[$group].entries[]?.id // empty' "$matrix" 2>/dev/null || true)
  fi
  if ((${#models[@]} == 1)); then
    models+=(
      "cliproxyapi/gpt-6-luna:${effort}"
      "cliproxyapi/gemini-pro-agent:${effort}"
      "cliproxyapi/gemini-3.8-flash-high:${effort}"
    )
  fi
fi

# Pure review call: no tools, extensions, skills or project context, so the model only
# answers the prompt GGA built. Use the Keeper-backed model cache instead of refreshing
# the gateway catalog; a successful empty catalog must not erase usable cached models.
offline=(--offline)
err=$(mktemp)
out=$(mktemp)
failures=$(mktemp)
input=$(mktemp)
cat >"$input"
trap 'rm -f "$err" "$out" "$failures" "$input"' EXIT
for candidate in "${models[@]}"; do
  : >"$err"
  : >"$out"
  ext=()
  if [[ $candidate == cliproxyapi/* ]]; then
    provider_ext="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/npm/node_modules/@router-for-me/pi-cliproxyapi-provider/extensions/index.ts"
    [ -f "$provider_ext" ] || { printf 'gga-pi: CLIProxyAPI provider extension not found: %s\n' "$provider_ext" >&2; exit 1; }
    ext=(-e "$provider_ext")
  fi
  if pi --print --no-session --no-tools --no-extensions --no-skills --no-prompt-templates \
    --no-themes --no-context-files --no-mcp "${offline[@]}" "${ext[@]}" \
    --system-prompt 'You are a strict code reviewer. Follow the review instructions in the prompt exactly and reply in the requested format.' \
    --model "$candidate" <"$input" >"$out" 2>"$err"; then
    if grep -Eq '^STATUS: (PASSED|FAILED)$' "$out"; then
      cat "$out"
      exit 0
    fi
    printf 'ambiguous review output: %s\n' "$candidate" >>"$failures"
    cat "$out" >>"$failures"
  else
    printf 'model failed: %s\n' "$candidate" >>"$failures"
  fi
  cat "$err" >>"$failures"
done
cat "$failures" >&2
exit 1
