# Gentleman Guardian Angel Configuration
# https://github.com/Gentleman-Programming/gga

# AI provider. Reviews use this repository's project-scoped `.codex/config.toml`:
# its model follows Pi's tracked `defaultModel` (gpt-5.6-luna), with xhigh effort.
PROVIDER="codex"
# GGA's Codex path keeps only the final assistant message
# (`codex exec --output-last-message`), so the verdict line is the first thing the
# parser sees. The earlier OpenCode setup returned the whole transcript, and a
# tool-heavy review pushed `STATUS:` past the 30-line scan window, which is why
# this file used to tolerate an unparsed verdict.

# This is a dotfiles / Pi-config repo: bash installer + JSON/TS Pi config +
# Markdown directives. The generated npm lockfile is excluded (huge, machine
# derived, and carries pre-existing recursive-path churn).
FILE_PATTERNS="*.sh,*.json,*.ts,*.mjs,*.md,*.lua,*.toml"
EXCLUDE_PATTERNS="package-lock.json,node_modules/*,*.log,*.jsonl,logs/*"

# Dedicated review rules for this repo (not the pi agent AGENTS.md).
RULES_FILE="REVIEW_RULES.md"

# The Codex path returns only the final assistant message, so the verdict is the
# first line the parser sees. Strict mode is the fail-closed default: an
# unparseable verdict blocks the commit instead of passing it.
STRICT_MODE="true"

# Larger changesets (upstream syncs) need a longer window.
TIMEOUT="900"
