# Public repo: ignore everything unless explicitly allowed below.
/*
!/.gitignore
!/advisor-system.md
!/pi-extensible-workflows
!/.pii-allowlist
!/AGENTS.md
!/README.md
!/MODELS.md
!/package.json
!/tsconfig.json
!/settings.json
!/pi-packages.txt
!/models.json
!/modes.json
!/keybindings.json
!/pi-vcc-config.json
!/subagents.json

!/extensions/
!/extensions/**
!/packages/
!/packages/**
/extensions/herdr-agent-state.ts
# Runtime artifacts of the pi-workflows package root. setup-ai's pi-workflows module
# creates them when it installs pi-extensible-workflows there, so they are machine
# state rather than configuration, and node_modules must never be committed. They
# live in this file rather than the repository root because the negation above
# re-allows /extensions/**, and a deeper .gitignore wins over a shallower one.
/extensions/pi-ext-workflows/.npmrc
/extensions/pi-ext-workflows/package.json
/extensions/pi-ext-workflows/package-lock.json
/extensions/pi-ext-workflows/node_modules/
!/bin/
!/bin/**
!/agents/
!/agents/**
!/prompts/
!/prompts/**
!/skills/
/skills/*
!/skills/learning-opportunities/
!/skills/learning-opportunities/**
!/skills/orient/
!/skills/orient/**
!/skills/tigerstyle/
!/skills/tigerstyle/**
!/skills/issue-ops/
!/skills/issue-ops/**
!/skills/container-test-matrix/
!/skills/container-test-matrix/**
!/themes/
!/themes/**
!/npm/
/npm/*
!/npm/.gitignore
!/npm/package.json
!/npm/package-lock.json

# Local credentials and machine state, including files inside allowed trees.
/auth.json
/ha.json
/ha.json.*
/extensions/home-assistant/config.json
/trust.json
/sessions/
/git/
/npm/node_modules/
*.log
*.lock
*.pid
*.bak
*.bak-*
