{
  "runtime_repo": "https://github.com/darkrei08/SkillOpt.git",
  "runtime_ref": "main",
  "project": ".",
  "source": "pi",
  "backend": "pi",
  "target_skill_path": "~/.agents/skills/skillopt-sleep-learned/SKILL.md",
  "engram_chunks_dir": ".engram/chunks",
