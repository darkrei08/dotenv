# Copy to keeper.env (git-ignored, mode 600) and replace both placeholders.
# Same plaintext value as remote-management.secret-key in config.yaml.
CPA_MANAGEMENT_KEY=REPLACE_WITH_THE_CPA_MANAGEMENT_KEY
# Password for the Keeper web login at http://127.0.0.1:8080.
LOGIN_PASSWORD=REPLACE_WITH_A_PRIVATE_KEEPER_PASSWORD
# Business timezone for Today, daily aggregation and log timestamps.
TZ=Europe/Rome
